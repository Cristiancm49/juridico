# Dominio con registro DNS A apuntando al VPS.
# Sin dominio, usa: http://IP_PUBLICA_DEL_VPS
APP_DOMAIN=consultorio.midominio.com

# SQL Server Express es gratuito y admite bases de hasta 10 GB.
# Usa Standard solo si cuentas con una licencia valida.
MSSQL_PID=Express
MSSQL_SA_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SQL_SEGURA

# Generar con: openssl rand -base64 48
JWT_SIGNING_KEY=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_BYTES
JWT_EXPIRATION_MINUTES=60

# Asistente de IA. La aplicacion funciona con clasificador local si se desactiva.
GEMINI_ENABLED=true
GEMINI_API_KEY=PEGAR_CLAVE_DE_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-2.5-flash

# Administrador obligatorio creado en el primer arranque.
ADMIN_NAME=Administrador del Consultorio
ADMIN_EMAIL=admin@midominio.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DE_ADMIN_SEGURA

# En produccion debe permanecer en false para no cargar informacion ficticia.
SEED_DEMO_DATA=false

# Usuarios iniciales opcionales. Roles validos:
# ADMIN, JEFE_PROGRAMA, COORDINADORA, DOCENTE, ESTUDIANTE, SOLICITANTE
INITIAL_USER_1_NAME=Coordinacion del Consultorio
INITIAL_USER_1_EMAIL=coordinacion@midominio.com
INITIAL_USER_1_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
INITIAL_USER_1_ROLE=COORDINADORA

INITIAL_USER_2_NAME=
INITIAL_USER_2_EMAIL=
INITIAL_USER_2_PASSWORD=
INITIAL_USER_2_ROLE=

INITIAL_USER_3_NAME=
INITIAL_USER_3_EMAIL=
INITIAL_USER_3_PASSWORD=
INITIAL_USER_3_ROLE=

INITIAL_USER_4_NAME=
INITIAL_USER_4_EMAIL=
INITIAL_USER_4_PASSWORD=
INITIAL_USER_4_ROLE=

