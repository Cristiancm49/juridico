{
  "name": "legaldesk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB,ALERTS -c blue,green,yellow \"npm run dev --workspace @legaldesk/api\" \"npm run dev --workspace @legaldesk/web\" \"npm run dev:worker --workspace @legaldesk/api\"",
    "build": "npm run build --workspace @legaldesk/web",
    "test": "npm run test --workspaces --if-present",
    "test:cases": "npm run test:cases --workspace @legaldesk/api",
    "test:case-tracking": "npm run test:case-tracking --workspace @legaldesk/api",
    "test:actions": "npm run test:actions --workspace @legaldesk/api",
    "test:documents": "npm run test:documents --workspace @legaldesk/api",
    "test:tasks": "npm run test:tasks --workspace @legaldesk/api",
    "test:reports": "npm run test:reports --workspace @legaldesk/api",
    "test:performance": "npm run test:performance --workspace @legaldesk/api",
    "worker": "npm run worker --workspace @legaldesk/api",
    "test:intake": "npm run test:intake --workspace @legaldesk/api",
    "test:requests": "npm run test:requests --workspace @legaldesk/api",
    "test:roles": "npm run test:roles --workspace @legaldesk/api",
    "db:migrate": "npm run db:migrate --workspace @legaldesk/api",
    "db:seed": "npm run db:seed --workspace @legaldesk/api",
    "start": "npm run start --workspace @legaldesk/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
