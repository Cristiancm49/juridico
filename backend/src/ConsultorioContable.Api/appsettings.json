{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "DemoData": false
  },
  "Jwt": {
    "Issuer": "ConsultorioContable.Api",
    "Audience": "ConsultorioContable.Web",
    "SigningKey": "CHANGE_ME_WITH_A_SECRET_OF_32_BYTES_MINIMUM",
    "ExpirationMinutes": 30
  },
  "Gemini": {
    "Enabled": true,
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
